    "    X_mcar_cc\n",
    ").fit()\n",
    "\n",
    "\n",
    "print(\"\\n===== MCAR + COMPLETE CASE =====\")\n",
    "\n",
    "print(\n",
    "    \"Observations:\",\n",
    "    len(df_mcar_cc)\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Estimated coefficients:\"\n",
    ")\n",
    "\n",
    "print(results_mcar_cc.params)\n",
    "save_point_estimates(\"Complete Case\", \"MCAR\", results_mcar_cc.params)\n"
