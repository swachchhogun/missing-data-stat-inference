    "# ==========================================\n",
    "# STEP 1: CREATE COMPLETE MULTIVARIABLE DATA\n",
    "# ==========================================\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import statsmodels.api as sm\n",
    "\n",
    "from scipy.special import expit\n",
    "\n",
    "from scipy.stats import t\n",
    "\n",
    "# Reproducibility\n",
    "np.random.seed(42)\n",
    "\n",
    "# Number of observations\n",
    "n = 100\n",
    "\n",
    "\n",
    "# ------------------------------------------\n",
    "# Generate three predictors\n",
    "# ------------------------------------------\n",
    "\n",
    "X1 = np.random.normal(\n",
    "    loc=0,\n",
    "    scale=1,\n",
    "    size=n\n",
    ")\n",
    "\n",
    "X2 = np.random.normal(\n",
    "    loc=0,\n",
    "    scale=1,\n",
    "    size=n\n",
    ")\n",
    "\n",
    "X3 = np.random.normal(\n",
    "    loc=0,\n",
    "    scale=1,\n",
    "    size=n\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------\n",
    "# Generate random error\n",
    "# ------------------------------------------\n",
    "\n",
    "epsilon = np.random.normal(\n",
    "    loc=0,\n",
    "    scale=1,\n",
    "    size=n\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------\n",
    "# Generate Y\n",
    "#\n",
    "# True model:\n",
    "# Y = 5 + 2X1 - 1.5X2 + X3 + epsilon\n",
    "# ------------------------------------------\n",
    "\n",
    "Y = (\n",
    "    5\n",
    "    + 2 * X1\n",
    "    - 1.5 * X2\n",
    "    + X3\n",
    "    + epsilon\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------\n",
    "# Put everything into one DataFrame\n",
    "# ------------------------------------------\n",
    "\n",
    "df = pd.DataFrame({\n",
    "    \"X1\": X1,\n",
    "    \"X2\": X2,\n",
    "    \"X3\": X3,\n",
    "    \"Y\": Y\n",
    "})\n",
    "\n",
    "\n",
    "print(df.head())\n",
    "\n",
    "print(\"\\nShape of dataset:\", df.shape)"
   ]
  },
  {
   "cell_type": "code",
   "source": [
    "# ==========================================\n",
    "# STEP 2: BASELINE REGRESSION\n",
    "# ==========================================\n",
    "\n",
    "# True coefficients\n",
    "beta0_true = 5\n",
    "beta1_true = 2\n",
    "beta2_true = -1.5\n",
    "beta3_true = 1\n",
    "\n",
    "\n",
    "# Predictor matrix\n",
    "X_model = sm.add_constant(\n",
    "    df[[\"X1\", \"X2\", \"X3\"]]\n",
    ")\n",
    "\n",
    "\n",
    "# Create OLS model\n",
    "model = sm.OLS(\n",
    "    df[\"Y\"],\n",
    "    X_model\n",
    ")\n",
    "\n",
    "\n",
    "# Fit model\n",
    "results = model.fit()\n",
    "\n",
    "\n",
    "# Show regression summary\n",
    "print(results.summary())\n",
    "\n",
    "\n",
    "# Extract estimated coefficients\n",
    "beta_hat = results.params\n",
    "\n",
    "print(\"\\nEstimated coefficients:\")\n",
    "print(beta_hat)"
   ],
