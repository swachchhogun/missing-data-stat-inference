    "# ==========================================\n",
    "# STEP 6A: MCAR + COMPLETE CASE\n",
    "# ==========================================\n",
    "\n",
    "df_mcar_cc = df_mcar.dropna()\n",
    "\n",
    "\n",
    "X_mcar_cc = sm.add_constant(\n",
